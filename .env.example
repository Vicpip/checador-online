# Copy this file to .env and fill in your values.
# Every value here customizes this deployment — see CONTEXT_CHECADOR.md /
# README.md for the full customization guide. Branding (company name,
# colors, logo) is NOT set here — configure it after first boot in the
# admin panel's Configuración page (or via PUT /admin/config).

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fieldcheck:fieldcheck@postgres:5432/fieldcheck
POSTGRES_USER=fieldcheck
POSTGRES_PASSWORD=fieldcheck
POSTGRES_DB=fieldcheck

# ── Timezone ──────────────────────────────────────────────────────────────
# Business timezone for this deployment (used for the OS clock in both the
# backend and postgres containers, and for interpreting HORA_LIMITE_ENTRADA /
# HORA_INICIO_JORNADA below). Timestamps are always stored in the database as
# UTC — this only controls wall-clock business-day boundaries and the
# fallback default hours. Both frontends independently render all times in
# America/Mexico_City regardless of this value.
TZ=America/Mexico_City

# ── Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# ── App branding (fallback labels; company name/colors/logo live in the DB
#    `config` table, editable from the admin panel — no rebuild needed) ────
APP_NAME=field-check
WORKER_ROLE_LABEL=Técnico        # rename to: Driver, Agent, Rep, Field Tech…
ADMIN_ROLE_LABEL=Administrador   # rename to: Supervisor, Dispatcher, Manager…

# ── Business rules (fallback defaults only — once an admin sets these in the
#    Configuración page, the DB `config` table wins over these env vars) ───
HORA_INICIO_JORNADA=08:00        # nominal start of the work day
HORA_LIMITE_ENTRADA=08:00        # check-in after this time = late

# ── Photo & logo storage ──────────────────────────────────────────────────
FOTOS_BASE_PATH=/var/fieldcheck/fotos
LOGO_BASE_PATH=/var/fieldcheck/logo
FOTO_MAX_WIDTH=1200               # px, applied client-side before upload
FOTO_QUALITY=0.75                 # JPEG quality 0-1, applied client-side

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-domain.com

# ── Frontend build-time vars (frontend/admin and frontend/pwa .env) ───────
# VITE_API_URL=http://localhost:8000
